<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_bg">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="СЛЕДУЮЩАЯ СЪЁМКА" android:textColor="#D9C3B1" android:textSize="11sp" android:textStyle="bold"
        android:layout_marginBottom="6dp" />
        <LinearLayout android:id="@+id/r1" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginTop="0dp">
            <TextView android:id="@+id/w1" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#A7D8F0" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" />
            <TextView android:id="@+id/t1" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#EFE3D8" android:textSize="17sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/s1" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#D9C3B1" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
    <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Ближайших съёмок нет" android:textColor="#D9C3B1" android:textSize="14sp" android:visibility="gone" />
</LinearLayout>
